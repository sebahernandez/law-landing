---
import '@fontsource-variable/lora';
import '@fontsource-variable/lora/wght-italic.css';
import '@fontsource-variable/inter';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Serrano Abogados | Abogado independiente en familia, penal y civil',
  description = 'Abogado independiente en derecho de familia, defensa penal y demandas civiles. Agenda una consulta gratuita y recibe representación legal personal y directa.',
} = Astro.props;

const asset = (file: string) => `${import.meta.env.BASE_URL}/${file}`.replace(/\/+/g, '/');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CL" />
    <meta name="theme-color" content="#0f3d35" />
    <link rel="icon" href={asset('favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="manifest" href={asset('site.webmanifest')} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <div data-scroll-sentinel aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-px w-px"></div>
    <a
      href="#main"
      class="focus:bg-brand-800 sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:px-4 focus:py-3 focus:text-white"
    >
      Saltar al contenido
    </a>
    <slot />

    <script>
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Mobile menu
      const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-button]');
      const menu = document.querySelector<HTMLElement>('[data-menu]');
      if (menuButton && menu) {
        const setOpen = (open: boolean) => {
          menuButton.setAttribute('aria-expanded', String(open));
          menu.hidden = !open;
          menuButton.querySelector('[data-icon-open]')?.classList.toggle('hidden', open);
          menuButton.querySelector('[data-icon-close]')?.classList.toggle('hidden', !open);
        };
        menuButton.addEventListener('click', () =>
          setOpen(menuButton.getAttribute('aria-expanded') !== 'true'),
        );
        menu.addEventListener('click', (e) => {
          if ((e.target as HTMLElement).closest('a')) setOpen(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && menuButton.getAttribute('aria-expanded') === 'true') {
            setOpen(false);
            menuButton.focus();
          }
        });
      }

      // Sticky header: toggle data-scrolled once the top sentinel leaves the viewport
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const sentinel = document.querySelector<HTMLElement>('[data-scroll-sentinel]');
      if (header && sentinel && 'IntersectionObserver' in window) {
        new IntersectionObserver(([entry]) => {
          header.toggleAttribute('data-scrolled', !entry.isIntersecting);
        }).observe(sentinel);
      } else if (header) {
        const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 0);
        update();
        window.addEventListener('scroll', update, { passive: true });
      }

      // Stagger siblings by 80ms
      const revealEls = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
      const groups = new Map<Element | null, number>();
      revealEls.forEach((el) => {
        const parent = el.parentElement;
        const index = groups.get(parent) ?? 0;
        el.style.setProperty('--delay', `${index * 80}ms`);
        groups.set(parent, index + 1);
      });

      // Stat counters
      const animateCount = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const suffix = el.dataset.suffix ?? '';
        if (reduceMotion || Number.isNaN(target)) return;
        const duration = 1400;
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - t, 3);
          el.textContent = `${Math.round(target * eased)}${suffix}`;
          if (t < 1) requestAnimationFrame(tick);
        };
        el.textContent = `0${suffix}`;
        requestAnimationFrame(tick);
      };

      const counters = Array.from(document.querySelectorAll<HTMLElement>('[data-count]'));

      if (!('IntersectionObserver' in window)) {
        revealEls.forEach((el) => el.classList.add('is-visible'));
      } else {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        revealEls.forEach((el) => revealObserver.observe(el));

        const countObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                animateCount(entry.target as HTMLElement);
                countObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.6 },
        );
        counters.forEach((el) => countObserver.observe(el));
      }

      // Legal dialogs: any in-page link whose fragment matches a dialog id opens it.
      const legalDialogs = new Map(
        [...document.querySelectorAll<HTMLDialogElement>('dialog[data-legal-dialog]')].map((d) => [d.id, d]),
      );
      if (legalDialogs.size > 0) {
        const clearUrl = () => history.replaceState(null, '', location.pathname + location.search);
        const openLegal = (id: string) => {
          const dialog = legalDialogs.get(id);
          if (!dialog || dialog.open) return false;
          dialog.showModal();
          history.replaceState(null, '', `#${id}`);
          return true;
        };
        const openFromHash = () => openLegal(decodeURIComponent(location.hash.slice(1)));

        document.addEventListener('click', (event) => {
          const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
          if (link && legalDialogs.has(link.hash.slice(1))) {
            event.preventDefault();
            openLegal(link.hash.slice(1));
          }
        });

        legalDialogs.forEach((dialog) => {
          dialog.querySelector('[data-legal-close]')?.addEventListener('click', () => dialog.close());
          // The dialog has no padding, so a click on the element itself is a backdrop click.
          dialog.addEventListener('click', (event) => {
            if (event.target === dialog) dialog.close();
          });
          dialog.addEventListener('close', () => {
            if (legalDialogs.has(location.hash.slice(1))) clearUrl();
          });
        });

        window.addEventListener('hashchange', openFromHash);
        openFromHash();
      }
    </script>
  </body>
</html>
