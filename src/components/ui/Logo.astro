---
import Icon from './Icon.astro';

interface Props {
  name: string;
  tone?: 'light' | 'dark';
  href?: string;
}

const { name, tone = 'light', href = '#inicio' } = Astro.props;
---

<a
  href={href}
  class:list={[
    'inline-flex min-h-11 items-center gap-2.5 font-serif text-[1.375rem] leading-none font-medium',
    tone === 'dark' ? 'text-white' : 'text-brand-800',
  ]}
>
  <Icon name="scale" size={24} />
  <span>{name}</span>
</a>
