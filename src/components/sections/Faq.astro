---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { FaqItem } from '../../data/content';

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  items: FaqItem[];
}

const { eyebrow, title, intro, items } = Astro.props;
---

<section id="faq" aria-labelledby="faq-title" class="bg-paper-50 py-20 lg:py-28">
  <Container class="grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <SectionHeading id="faq-title" eyebrow={eyebrow} title={title} class="max-w-[30rem]" />
      <p data-reveal class="mt-6 max-w-[24rem] text-base leading-[1.65]">{intro}</p>
    </div>

    <div class="lg:col-span-7">
      {
        items.map((item, i) => (
          <details
            data-reveal
            open={i === 0}
            class="faq-item group border-line-200 border-b first:border-t lg:first:border-t-0"
          >
            <summary class="text-ink-900 flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 font-serif text-lg leading-[1.4] font-medium">
              <span>{item.question}</span>
              <svg
                class="text-brand-800 size-5 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                aria-hidden="true"
              >
                <path d="M5 12h14" />
                <path
                  d="M12 5v14"
                  class="origin-center transition-transform duration-200 group-open:scale-y-0"
                />
              </svg>
            </summary>
            <p class="pr-10 pb-6 text-[15px] leading-[1.65]">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </Container>
</section>
