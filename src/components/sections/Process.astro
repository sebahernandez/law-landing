---
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { ProcessStep } from '../../data/content';

interface Props {
  eyebrow: string;
  title: string;
  side: string;
  steps: ProcessStep[];
}

const { eyebrow, title, side, steps } = Astro.props;
---

<section id="proceso" aria-labelledby="process-title" class="bg-brand-800 on-dark py-20 lg:py-28">
  <Container>
    <div class="grid gap-6 lg:grid-cols-2 lg:items-end lg:gap-16">
      <SectionHeading id="process-title" eyebrow={eyebrow} title={title} tone="dark" class="max-w-[36rem]" />
      <p data-reveal class="text-on-dark-muted text-base leading-[1.65] lg:ml-auto lg:max-w-[22rem] lg:pb-2">
        {side}
      </p>
    </div>

    <ol class="mt-14 grid gap-10 md:grid-cols-2 md:gap-x-8 lg:mt-16 lg:grid-cols-4 lg:gap-x-8">
      {
        steps.map((step) => (
          <li data-reveal class="border-on-dark-line border-t pt-8">
            <span class="text-gold-500 font-serif text-base">{step.number}</span>
            <h3 class="text-on-dark mt-6 text-xl leading-[1.3] font-medium">{step.title}</h3>
            <p class="text-on-dark-muted mt-4 text-[15px] leading-[1.65]">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Container>
</section>
