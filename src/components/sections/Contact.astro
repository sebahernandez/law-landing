---
import Button from '../ui/Button.astro';
import Container from '../ui/Container.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import type { ContactItem } from '../../data/content';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  items: ContactItem[];
  form: {
    title: string;
    fields: {
      name: { label: string; placeholder: string };
      contact: { label: string; placeholder: string };
      type: { label: string; placeholder: string; options: string[] };
      message: { label: string; placeholder: string };
    };
    submit: string;
    disclaimer: string;
  };
}

const { eyebrow, title, lead, items, form } = Astro.props;
const { fields } = form;
---

<section id="contacto" aria-labelledby="contact-title" class="bg-cream-100 py-20 lg:py-28">
  <Container class="grid gap-12 lg:grid-cols-[58fr_42fr] lg:items-start lg:gap-16">
    <div>
      <SectionHeading id="contact-title" eyebrow={eyebrow} title={title} class="max-w-[46rem]" />
      <p data-reveal class="mt-6 max-w-[32rem] text-base leading-[1.65]">{lead}</p>
      <ul class="mt-8 space-y-1">
        {
          items.map((item) => (
            <li data-reveal class="text-ink-900 flex min-h-11 items-center gap-3 text-base">
              <Icon name={item.icon} size={20} class="text-brand-800" />
              <span class="break-words">{item.text}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <form
      data-reveal
      action="#"
      method="post"
      class="border-line-200 space-y-5 rounded-lg border bg-white p-6 md:p-10"
    >
      <h3 class="text-ink-900 text-2xl leading-[1.3] font-medium">{form.title}</h3>
      <FormField id="f-name" name="name" label={fields.name.label} placeholder={fields.name.placeholder} autocomplete="name" required />
      <FormField id="f-contact" name="contact" label={fields.contact.label} placeholder={fields.contact.placeholder} autocomplete="email" required />
      <FormField id="f-type" name="type" as="select" label={fields.type.label} placeholder={fields.type.placeholder} options={fields.type.options} required />
      <FormField id="f-message" name="message" as="textarea" label={fields.message.label} placeholder={fields.message.placeholder} required />
      <Button variant="block" type="submit">{form.submit}</Button>
      <p class="text-ink-600 text-sm leading-normal">{form.disclaimer}</p>
    </form>
  </Container>
</section>
