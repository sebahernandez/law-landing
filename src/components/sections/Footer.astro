---
import Container from '../ui/Container.astro';
import Logo from '../ui/Logo.astro';
import type { FooterColumn } from '../../data/content';

interface Props {
  brand: string;
  description: string;
  columns: FooterColumn[];
  copyright: string;
  disclaimer: string;
}

const { brand, description, columns, copyright, disclaimer } = Astro.props;
---

<footer class="bg-brand-900 on-dark pt-16 pb-8 lg:pt-20">
  <Container>
    <div class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-[1.5fr_1fr_1fr_1fr] md:gap-x-8">
      <div class="col-span-2 md:col-span-1">
        <Logo name={brand} tone="dark" />
        <p class="text-on-dark-muted mt-4 max-w-[22rem] text-[15px] leading-[1.65]">{description}</p>
      </div>
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="font-sans text-[15px] font-semibold tracking-wide text-white">{column.title}</h2>
            <ul class="mt-3">
              {column.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-on-dark-muted flex min-h-11 items-center text-[15px] transition-colors hover:text-white"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <div
      class="border-on-dark-line text-on-dark-muted mt-12 flex flex-col gap-3 border-t pt-8 text-sm leading-normal lg:flex-row lg:justify-between"
    >
      <p>{copyright}</p>
      <p>{disclaimer}</p>
    </div>
  </Container>
</footer>
